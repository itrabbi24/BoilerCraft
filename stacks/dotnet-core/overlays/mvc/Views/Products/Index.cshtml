@model IEnumerable<Product>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Products</h1>
    <a asp-action="Create" class="btn btn-primary">+ New product</a>
</div>

@if (TempData["Status"] is string status)
{
    <div class="alert alert-success">@status</div>
}

@if (!Model.Any())
{
    <p class="text-muted">No products yet. <a asp-action="Create">Create the first one</a>.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.Name)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.Price)</th>
                <th>@Html.DisplayNameFor(m => m.Description)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td class="text-end">@item.Price.ToString("0.00")</td>
                    <td class="text-muted">@item.Description</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
