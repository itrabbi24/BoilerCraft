<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <!-- Solid Pure Dark Navy Square -->
  <rect width="512" height="512" rx="96" fill="#0f172a" />
  
  <!-- Outer Flat Hexagon Frame -->
  <polygon points="256,64 430,164 430,364 256,464 82,364 82,164" 
           fill="none" stroke="#0284c7" stroke-width="26" stroke-linejoin="round" />
  
  <!-- Inner Flat Architecture Lines -->
  <line x1="256" y1="64" x2="256" y2="180" stroke="#0284c7" stroke-width="20" stroke-linecap="round" />
  <line x1="430" y1="364" x2="330" y2="306" stroke="#0284c7" stroke-width="20" stroke-linecap="round" />
  <line x1="82" y1="364" x2="182" y2="306" stroke="#0284c7" stroke-width="20" stroke-linecap="round" />

  <!-- Solid Flat Lightning Monogram (Pure Solid Cyan, No Gradient, No Shadow) -->
  <polygon points="280,110 160,280 244,280 220,410 352,240 268,240" 
           fill="#00d8ff" />
</svg>
